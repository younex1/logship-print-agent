# Remote-support tunnel (logship-print-support.service) — only used after "Fernwartung 8 h" in LogShip.
# The key is installed by the appliance playbook; REMOTE_PORT must be unique per device.
SUPPORT_HOST=edge.logship.de
SUPPORT_PORT=22
SUPPORT_USER=printsupport
SUPPORT_KEY=/etc/logship-print-agent/support_key
REMOTE_PORT=22001
