# LogShip Print Agent — /etc/logship-print-agent/agent.env
# Filled by `logship-print-agent enroll --url … --code …` or the setup page http://<host>:8080
LOGSHIP_URL=
LOGSHIP_AGENT_TOKEN=
LOGSHIP_AGENT_NAME=Print-Agent

# Optional tuning (defaults shown)
#POLL_WAIT=25
#POLL_MAX=50
#HEARTBEAT_SECONDS=60
#COMPLETION_POLL_MS=2000
#MAX_ACTIVE_PER_QUEUE=40
#SETUP_PORT=8080
#SETUP_BIND=0.0.0.0
#AUTO_PROVISION_USB=1
#AUTO_PROVISION_MAKES=Zebra
#AUTO_PROVISION_DRIVER=drv:///sample.drv/zebra.ppd
#CUPS_PPD_DIR=/etc/cups/ppd
#BACKUP_ENABLED=1
#STATE_DIR=/var/lib/logship-print-agent
